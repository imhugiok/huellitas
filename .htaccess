# Huellitas al Corazon — configuracion de servidor (Apache / LiteSpeed, Hostinger)

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS. Si en hPanel ya activaste "Forzar HTTPS", esto es redundante
    # pero no estorba. La segunda condicion cubre el caso detras de proxy.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Nada de codigo fuente ni contenido servido en crudo.
    RewriteRule ^(data|lib|partials)/ - [F,L]

    # El sitemap se genera con la fecha real de /data/contenido.php.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # /galeria sin extension. El servidor de PHP en local no lee .htaccess,
    # asi que ahi hay que entrar por /galeria.php.
    RewriteRule ^galeria/?$ galeria.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # La CSP se manda desde index.php porque lleva nonce por peticion.

    # Los assets llevan ?v=hash en la URL, asi que se pueden cachear un ano.
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # El HTML nunca se cachea duro: es lo que cambia al editar el contenido.
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
        application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>
